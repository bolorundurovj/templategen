{
  "name": "<%= projectName %>",
  "version": "1.0.0",
  "description": "NestJS JavaScript API scaffolded with TemplateGen",
  "private": true,
  "scripts": {
    "start": "node src/main.js",
    "dev": "nodemon src/main.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "@nestjs/common": "^10.3.3",
    "@nestjs/core": "^10.3.3",
    "@nestjs/platform-express": "^10.3.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"<% if (database === 'mongodb') { %>,
    "mongoose": "^8.2.0"<% } %><% if (database === 'postgresql') { %>,
    "pg": "^8.11.3"<% } %><% if (database === 'mysql') { %>,
    "mysql2": "^3.9.2"<% } %><% if (database === 'sqlite') { %>,
    "sqlite3": "^5.1.7"<% } %>
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.3",
    "nodemon": "^3.0.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testRegex": ".*\\.spec\\.js$",
    "testEnvironment": "node"
  }
}
