# Server
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_FILE=logs/app.log

<% if (database === 'mongodb') { %># Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/<%= projectName %>
<% } else if (database === 'postgresql') { %># Database (PostgreSQL)
DATABASE_URL=dbname=<%= projectName %> user=postgres password=postgres host=localhost
<% } else if (database === 'mysql') { %># Database (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=password
DB_NAME=<%= projectName %>
<% } else if (database === 'sqlite') { %># Database (SQLite)
DATABASE_PATH=./database.sqlite
<% } %>
