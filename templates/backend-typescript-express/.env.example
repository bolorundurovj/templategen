# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE=logs/app.log

<% if (database === 'mongodb') { %># Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/<%= projectName %>
<% } else if (database === 'postgresql') { %># Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/<%= projectName %>
<% } else if (database === 'mysql') { %># Database (MySQL)
DATABASE_URL=mysql://root:password@localhost/<%= projectName %>
<% } else if (database === 'sqlite') { %># Database (SQLite)
DATABASE_PATH=./database.sqlite
<% } %>
